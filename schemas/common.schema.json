{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:logicatlas:schema:common:1.0.0",
  "title": "LogicAtlas common 1.0.0",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]{0,95}$"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8000,
      "pattern": "\\S"
    },
    "behavior": {
      "enum": [
        "implemented",
        "planned",
        "unknown"
      ]
    },
    "coverage": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "complete",
            "partial",
            "unreviewed"
          ]
        },
        "scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000,
          "pattern": "\\S"
        },
        "gaps": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8000,
            "pattern": "\\S"
          },
          "uniqueItems": true,
          "maxItems": 1000
        }
      },
      "required": [
        "status",
        "scope",
        "gaps"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "complete"
              }
            }
          },
          "then": {
            "properties": {
              "gaps": {
                "maxItems": 0,
                "type": "array"
              }
            }
          },
          "else": {
            "properties": {
              "gaps": {
                "minItems": 1,
                "type": "array"
              }
            }
          }
        }
      ]
    },
    "codeReference": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "symbol": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000,
          "pattern": "\\S"
        },
        "startLine": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "endLine": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        }
      },
      "required": [
        "path"
      ],
      "additionalProperties": false,
      "dependentRequired": {
        "endLine": [
          "startLine"
        ]
      }
    },
    "evidence": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "code",
            "inference",
            "unspecified"
          ]
        },
        "references": {
          "type": "array",
          "items": {
            "$ref": "urn:logicatlas:schema:common:1.0.0#/$defs/codeReference"
          },
          "maxItems": 100
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000,
          "pattern": "\\S"
        }
      },
      "required": [
        "kind",
        "references"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "code"
              }
            }
          },
          "then": {
            "properties": {
              "references": {
                "minItems": 1,
                "type": "array"
              }
            },
            "not": {
              "required": [
                "reason"
              ],
              "properties": {
                "reason": {}
              }
            }
          },
          "else": {
            "required": [
              "reason"
            ],
            "properties": {
              "reason": {}
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "unspecified"
              }
            }
          },
          "then": {
            "properties": {
              "references": {
                "maxItems": 0,
                "type": "array"
              }
            }
          }
        }
      ]
    },
    "repository": {
      "type": "object",
      "properties": {
        "host": {
          "const": "github.com"
        },
        "owner": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,38}$"
        },
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]{1,100}$",
          "not": {
            "enum": [
              ".",
              ".."
            ]
          }
        }
      },
      "required": [
        "host",
        "owner",
        "name"
      ],
      "additionalProperties": false
    }
  }
}
