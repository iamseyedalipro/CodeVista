      "evidence": {
        "kind": "code",
        "references": [
          {
            "path": "server/app.ts"
          },
          {
            "path": "server/store.ts"
          }
        ]
      }
    },
    {
      "id": "session-access.pending",
      "kind": "wait",
      "title": "Join or start one refresh",
      "description": "A per-session promise shares concurrent refreshes. A valid refresh token and expiry are required.",
      "behavior": "implemented",
      "evidence": {
        "kind": "code",
        "references": [
          {
            "path": "server/app.ts"
          },
          {
            "path": "server/store.ts"
          }
        ]
      }
    },
    {
      "id": "session-access.provider",
      "kind": "external",
      "title": "Exchange the refresh token",
      "description": "Request new GitHub OAuth tokens; store them only if the session still exists.",
      "behavior": "implemented",
      "evidence": {
        "kind": "code",
        "references": [
          {
            "path": "server/app.ts"
          },
          {
            "path": "server/store.ts"
          }
        ]
      }
    },
    {
      "id": "session-access.result",
      "kind": "decision",
      "title": "Did refresh finish with a live session?",
      "description": "Remove the shared promise in finally and reread the session.",
      "behavior": "implemented",
      "evidence": {
        "kind": "code",
        "references": [
          {
            "path": "server/app.ts"
          },
          {
            "path": "server/store.ts"
          }
        ]
      }
    },
    {
      "id": "session-access.done",
      "kind": "end",
      "title": "Return session context",
      "description": "Return session ID and decrypted session/account settings.",
      "behavior": "implemented",
      "evidence": {
        "kind": "code",
        "references": [
          {
            "path": "server/app.ts"
          },
          {
            "path": "server/store.ts"
          }
        ]
      },
      "outcome": "success"
    }
