      "id": "session-access.denied",
      "kind": "end",
      "title": "Require sign-in",
      "description": "Throw 401 SIGN_IN_REQUIRED or REAUTHENTICATE.",
      "behavior": "implemented",
      "evidence": {
        "kind": "code",
        "references": [
          {
            "path": "server/app.ts"
          },
          {
            "path": "server/store.ts"
          }
        ]
      },
