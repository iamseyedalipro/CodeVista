      "kind": "decision",
      "title": "Can a previous map be displayed?",
      "description": "Fallback requires enabled fallback, invalid/degraded selected result and a cached different SHA for the same session/repository/ref.",
      "behavior": "implemented",
      "evidence": {
        "kind": "code",
        "references": [
          {
            "path": "server/snapshots.ts"
          },
          {
            "path": "server/github.ts"
          }
        ]
      }
    },
    {
      "id": "snapshot-loading.old",
      "kind": "action",
      "title": "Label previous content explicitly",
      "description": "Keep displayed SHA from previous map and selected SHA/errors from current result; mark fallback and needs-review.",
      "behavior": "implemented",
      "evidence": {
        "kind": "code",
        "references": [
          {
            "path": "server/snapshots.ts"
          },
          {
            "path": "server/github.ts"
          }
        ]
      }
    },
    {
