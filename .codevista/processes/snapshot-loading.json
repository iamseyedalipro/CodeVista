            "path": "server/github.ts"
          }
        ]
      }
    },
    {
      "id": "snapshot-loading.retain",
      "kind": "action",
      "title": "Retain valid map if allowed",
      "description": "If latest sequence and fallback enabled, retain for fourteen minutes plus cleanup interval. Bound cache to twenty entries and 64 MiB.",
      "behavior": "implemented",
      "evidence": {
        "kind": "code",
        "references": [
          {
            "path": "server/snapshots.ts"
