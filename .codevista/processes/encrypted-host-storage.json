{
  "schemaVersion": "1.0.0",
  "id": "encrypted-host-storage",
  "title": "Persist and expire host identity data",
  "purpose": "Store encrypted session/OAuth/account payloads and prune expired data with bounded host retention rules.",
  "behavior": "implemented",
