      "evidence": {
        "kind": "code",
        "references": [
          {
            "path": "src/diff.ts"
          }
        ]
      }
    },
    {
      "id": "flow-comparison.classify",
      "kind": "decision",
      "title": "What changed for this identity?",
      "description": "Skip identical values in the same containing process.",
