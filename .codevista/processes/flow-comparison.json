        "kind": "code",
        "references": [
          {
            "path": "src/diff.ts"
          }
        ]
      }
    },
    {
      "id": "flow-comparison.removed",
      "kind": "action",
      "title": "Record removal",
      "description": "ID exists only in the previous bundle.",
      "behavior": "implemented",
      "evidence": {
        "kind": "code",
        "references": [
          {
            "path": "src/diff.ts"
          }
        ]
      }
    },
    {
      "id": "flow-comparison.moved",
      "kind": "action",
      "title": "Record a move",
      "description": "ID exists in both but its containing process changed; include changed fields as well.",
      "behavior": "implemented",
      "evidence": {
        "kind": "code",
        "references": [
          {
            "path": "src/diff.ts"
          }
        ]
      }
    },
    {
      "id": "flow-comparison.changed",
      "kind": "action",
      "title": "Record changed fields",
      "description": "Both entities stay in the same container and at least one field differs.",
      "behavior": "implemented",
      "evidence": {
        "kind": "code",
        "references": [
          {
            "path": "src/diff.ts"
          }
        ]
      }
    },
    {
      "id": "flow-comparison.next",
      "kind": "decision",
      "title": "Are more entities left?",
      "description": "Loop over all five entity categories.",
      "behavior": "implemented",
      "evidence": {
        "kind": "code",
        "references": [
          {
            "path": "src/diff.ts"
          }
        ]
      }
    },
    {
      "id": "flow-comparison.done",
      "kind": "end",
      "title": "Return change records",
      "description": "Include available before/after content and previous/current process IDs for exact navigation.",
