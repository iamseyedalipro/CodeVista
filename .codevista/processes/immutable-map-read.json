    },
    {
      "id": "immutable-map-read.edge-3",
      "from": "immutable-map-read.tree",
      "to": "immutable-map-read.invalid",
      "label": "Incomplete tree",
      "kind": "error",
      "condition": "Truncated tree throws a 413 error to caller"
    },
    {
      "id": "immutable-map-read.edge-4",
      "from": "immutable-map-read.manifest",
      "to": "immutable-map-read.missing",
      "label": "Absent",
      "kind": "normal",
      "condition": "Manifest path absent"
    },
    {
      "id": "immutable-map-read.edge-5",
      "from": "immutable-map-read.manifest",
      "to": "immutable-map-read.invalid",
      "label": "Unusable",
      "kind": "error",
      "condition": "Read/schema/repository/canonical declaration check fails"
    },
    {
      "id": "immutable-map-read.edge-6",
      "from": "immutable-map-read.manifest",
      "to": "immutable-map-read.documents",
      "label": "Accepted",
      "kind": "normal",
      "condition": "Manifest is valid and matches authorized repository"
    },
    {
      "id": "immutable-map-read.edge-7",
      "from": "immutable-map-read.documents",
      "to": "immutable-map-read.validate",
      "label": "Processes loaded",
      "kind": "normal"
    },
    {
      "id": "immutable-map-read.edge-8",
      "from": "immutable-map-read.validate",
      "to": "immutable-map-read.result",
      "label": "Inspect bundle diagnostics",
      "kind": "normal"
    },
    {
      "id": "immutable-map-read.edge-9",
      "from": "immutable-map-read.result",
      "to": "immutable-map-read.references",
      "label": "Bundle valid",
      "kind": "success",
      "condition": "validateBundle returns valid"
    },
    {
      "id": "immutable-map-read.edge-10",
      "from": "immutable-map-read.result",
      "to": "immutable-map-read.quarantine",
