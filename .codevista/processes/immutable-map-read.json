      "from": "immutable-map-read.result",
      "to": "immutable-map-read.invalid",
      "label": "Global failure",
      "kind": "error",
      "condition": "Errors ambiguous/global or quarantine cannot progress"
    },
    {
      "id": "immutable-map-read.edge-12",
      "from": "immutable-map-read.quarantine",
      "to": "immutable-map-read.validate",
      "label": "Revalidate placeholders",
      "kind": "normal"
    },
    {
      "id": "immutable-map-read.edge-13",
      "from": "immutable-map-read.references",
      "to": "immutable-map-read.freshness",
      "label": "Assess current map",
      "kind": "normal"
    },
    {
      "id": "immutable-map-read.edge-14",
      "from": "immutable-map-read.freshness",
      "to": "immutable-map-read.done",
      "label": "Return state",
      "kind": "normal"
