{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:codevista:schema:manifest:1.0.0",
  "title": "CodeVista manifest 1.0.0",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "project": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "urn:codevista:schema:common:1.0.0#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000,
          "pattern": "\\S"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000,
          "pattern": "\\S"
        },
        "contentLanguage": {
          "type": "string",
          "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
        },
        "repository": {
          "$ref": "urn:codevista:schema:common:1.0.0#/$defs/repository"
        }
      },
      "required": [
        "id",
        "name",
        "description",
        "contentLanguage",
        "repository"
      ],
      "additionalProperties": false
    },
    "coverage": {
      "$ref": "urn:codevista:schema:common:1.0.0#/$defs/coverage"
    },
    "rootProcessIds": {
      "type": "array",
      "items": {
        "$ref": "urn:codevista:schema:common:1.0.0#/$defs/id"
      },
      "minItems": 1,
      "maxItems": 1000,
      "uniqueItems": true
    },
    "processes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "urn:codevista:schema:common:1.0.0#/$defs/id"
          },
          "file": {
            "type": "string",
            "pattern": "^processes/[a-z][a-z0-9._-]{0,95}\\.json$"
          }
        },
        "required": [
          "id",
          "file"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 1000
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "urn:codevista:schema:common:1.0.0#/$defs/id"
          },
          "from": {
            "$ref": "urn:codevista:schema:common:1.0.0#/$defs/id"
          },
          "to": {
            "$ref": "urn:codevista:schema:common:1.0.0#/$defs/id"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8000,
            "pattern": "\\S"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8000,
            "pattern": "\\S"
          }
        },
        "required": [
          "id",
          "from",
          "to",
          "label",
          "description"
        ],
        "additionalProperties": false
      },
      "maxItems": 5000
    }
  },
  "required": [
    "schemaVersion",
    "project",
    "coverage",
    "rootProcessIds",
    "processes",
    "relationships"
  ],
  "additionalProperties": false
}
